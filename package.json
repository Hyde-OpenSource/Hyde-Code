{
  "name": "hyde-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @hyde/hub dev",
    "start": "pnpm --filter @hyde/hub start",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "hyde": "pnpm --silent --filter @hyde/hub cli",
    "build": "pnpm --filter @hyde/web build",
    "install-cli": "node scripts/install-cli.mjs",
    "desktop": "cargo run --manifest-path apps/desktop/Cargo.toml -p hyde-ai --",
    "desktop:test": "cargo test --manifest-path apps/desktop/Cargo.toml",
    "desktop:lint": "cargo clippy --manifest-path apps/desktop/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path apps/desktop/Cargo.toml --all --check",
    "desktop:install": "bash apps/desktop/scripts/install.sh",
    "test:all": "pnpm test && pnpm desktop:test",
    "setup:all": "bash scripts/install.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
