# Copy to .env (gitignored). Secrets live only here, never in hyde.config.json.

# From @BotFather. Leave empty to run without Telegram and use `pnpm hyde ...`.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to command the bot. If empty, the hub
# prints a one-time /pair code at startup instead.
TELEGRAM_ALLOWED_USER_IDS=
# Optional. Signs button presses; generated into .hyde/callback-secret if unset.
HYDE_CALLBACK_SECRET=
