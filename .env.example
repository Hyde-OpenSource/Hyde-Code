# Copy to .env (gitignored, 0600), or let `pnpm hyde setup` write it. Secrets live only here.
# Every section is optional: fill in only the chat apps you enabled.

# Telegram: token from @BotFather. Without allowed ids the hub prints a one-time /pair code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Slack (Socket Mode, no public URL): bot token xoxb-…, app-level token xapp-…
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USER_IDS=

# Discord: bot token; enable the Message Content intent for the bot.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=

# WhatsApp Cloud API, client-message intake only (needs a public URL for /webhooks/whatsapp).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_CLIENT_NUMBERS=

# Teammate worker nodes (nodes.enabled in hyde.config.json): nodeId:token pairs.
HYDE_NODE_TOKENS=

# Optional. Signs chat buttons; generated into .hyde/callback-secret if unset.
HYDE_CALLBACK_SECRET=
